    "guide.fields": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commençons par la production. Ouvre Ressources, touche une parcelle puis améliore-la. Un seul chantier peut avancer à la fois."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with production. Open Resources, tap a plot, then upgrade it. Only one construction project can progress at a time."
          }
        }
      }
    },
    "guide.academy": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton prochain objectif est la Maison des savoirs. Ouvre le Centre et choisis une parcelle libre pour la construire."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next goal is the House of Knowledge. Open Town and select an empty plot to build it."
          }
        }
      }
    },
    "guide.research": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la Maison des savoirs dans le Centre pour rechercher ta première unité. La recherche débloque le recrutement ; elle ne crée pas encore de troupes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the House of Knowledge in Town to research your first unit. Research unlocks recruitment; it does not create troops yet."
          }
        }
      }
    },
    "guide.barracks": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construis la Cour des armes sur une parcelle libre du Centre. Tu pourras ensuite y entraîner les unités recherchées."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build the Training Grounds on an empty Town plot. You can then train the units you have researched."
          }
        }
      }
    },
    "guide.train": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la Cour des armes pour entraîner tes premières troupes. Si un entraînement est déjà en cours, attends son terme. Garde des ressources pour les prochaines améliorations."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Training Grounds to train your first troops. If training is already underway, wait for it to finish. Keep resources for your next upgrades."
          }
        }
      }
    },
    "guide.raid": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Missions, prépare une attaque contre un voisin proche. Compare les forces et les pertes prévues avant de choisir tes troupes. Une expédition en cours doit rentrer avant le prochain départ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Missions, prepare an attack on a nearby neighbor. Compare strength and expected losses before selecting troops. An active expedition must return before the next departure."
          }
        }
      }
    },
    "guide.tip_title": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
