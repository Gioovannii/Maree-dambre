  },
  "raid.preview.win": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Victoire prévue · %@ perte(s) sur %@ troupes."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Expected victory · %@ losses from %@ troops."
        }
      }
    }
  },
  "raid.preview.loss": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Défaite prévue · %@ perte(s) sur %@ troupes. Aucun butin."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Expected defeat · %@ losses from %@ troops. No loot."
        }
      }
    }
  },
  "raid.preview.loot": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Butin : jusqu’à %@ de chaque ressource, selon le transport des survivants et la place en réserve."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Loot: up to %@ of each resource, depending on survivor carrying capacity and available storage."
        }
      }
    }
  },
  "raid.preview.rounding": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Les pertes sont calculées sur toute l’armée, pas arrondies séparément pour chaque type d’unité."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Losses are calculated across the whole army, rather than rounded separately for each unit type."
        }
      }
    }
  },
  "hero.raid.onboard": {
    "extractionState": "manual",
    "localizations": {
