  "hero.raid.join": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Envoyer le héros en soutien"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Send the hero in support"
        }
      }
    }
  },
  "hero.raid.rules": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Le héros accompagne l’armée jusqu’à son retour. Il gagne 20 XP en victoire ou 5 XP en défaite, au plus une fois par voisin et par jour."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The hero accompanies the army until it returns. Earns 20 XP on victory or 5 XP on defeat, at most once per neighbor per day."
        }
      }
    }
  },
  "hero.raid.bonus": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Soutien : +%@ en attaque."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Support: +%@ attack."
        }
      }
    }
  },
  "hero.raid.unavailable": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Choisissez un héros disponible : il ne peut pas participer à deux voyages en même temps."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Choose an available hero: they cannot join two voyages at the same time."
        }
