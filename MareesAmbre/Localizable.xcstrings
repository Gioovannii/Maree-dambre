    "hero.xp_rules": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combat gagné : 20 XP · Défaite : 5 XP · Colonie fondée : 75 XP. Un seul raid récompensé par voisin et par jour, et une défense par village et par jour (jours UTC). Les anciens rapports ne donnent pas d’XP."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battle won: 20 XP · Defeat: 5 XP · Colony founded: 75 XP. Only one rewarded raid per neighbor per day, and one defense per village per day (UTC days). Old reports grant no XP."
          }
        }
      }
