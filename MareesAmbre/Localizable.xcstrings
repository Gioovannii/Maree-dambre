  "backup.error": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Impossible de lire, enregistrer ou restaurer ce fichier. Vérifiez qu’il s’agit d’une sauvegarde compatible de Marées d’Ambre."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Unable to read, save, or restore this file. Check that it is a compatible Marées d’Ambre backup."
        }
      }
    }
  },
  "people.specialty.human.title": {
