  "cloud.signin": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Connectez-vous à iCloud dans les réglages de cet appareil pour retrouver vos sauvegardes."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Sign into iCloud in this device’s settings to access your backups."
        }
      }
    }
  },
  "cloud.unavailable": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "iCloud est indisponible. Vérifiez la connexion ou réessayez plus tard. La partie locale est conservée."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "iCloud is unavailable. Check your connection or try again later. Your local game is retained."
        }
      }
    }
  },
  "cloud.saved": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Partie sauvegardée dans votre iCloud."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Game backed up to your iCloud."
        }
      }
    }
  },
  "cloud.failed": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Envoi impossible ou sauvegarde modifiée depuis un autre appareil. Actualisez iCloud avant de réessayer. Aucun remplacement forcé n’a été effectué."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Upload failed or the backup changed on another device. Refresh iCloud before trying again. No forced replacement was performed."
        }
      }
    }
  },
  "cloud.refresh": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Actualiser iCloud"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Refresh iCloud"
        }
      }
    }
  },
  "cloud.upload": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Sauvegarder cette partie dans iCloud"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Back up this game to iCloud"
        }
      }
    }
  },
  "cloud.restore": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Restaurer la partie iCloud"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Restore the iCloud game"
        }
      }
    }
  },
  "cloud.explanation": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "L’envoi et la restauration sont manuels. Sur l’appareil où se trouve votre progression, envoyez-la dans iCloud. Sur l’autre appareil, actualisez puis restaurez-la. Les parties ne sont pas fusionnées."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Upload and restore are manual. Upload from the device with your progress. On your other device, refresh and restore it. Games are not merged."
        }
      }
    }
  },
  "cloud.confirm": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Enregistrer cette partie dans iCloud ?"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Save this game to iCloud?"
        }
      }
    }
  },
  "cloud.replace": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Cela remplace la sauvegarde iCloud actuellement affichée par la partie de cet appareil. Vos autres appareils ne seront pas modifiés automatiquement."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This replaces the displayed iCloud backup with progress from this device. Your other devices will not change automatically."
        }
      }
    }
  },
  "backup.explanation": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "La partie est enregistrée sur cet appareil. Exportez-la vers Fichiers ou AirDrop, puis importez le fichier sur votre autre appareil. Le compte Apple ne synchronise pas encore la partie automatiquement."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Progress is saved on this device. Export it to Files or AirDrop, then import the file on your other device. Your Apple account does not automatically sync progress yet."
        }
      }
    }
  },
  "backup.export": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Exporter ma partie"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
