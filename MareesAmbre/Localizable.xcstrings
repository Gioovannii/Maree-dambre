      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les troupes présentes défendent le port. Les unités en expédition ou encore en formation ne participent pas. La Tour ajoute 20 de défense ; les armes ajoutent 1 par niveau et par unité."
          }
        },
