  "hero.raid.busy_help": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Le héros accompagne un raid. Ses missions seront disponibles à son retour."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The hero is accompanying a raid. Personal missions will be available on return."
        }
      }
    }
  },
  "hero.command_support": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Envoyez votre héros avec un raid pour lui faire gagner de l’XP au retour. Son soutien ajoute 2 points d’attaque par niveau, jusqu’à 20 points. Il reste indisponible jusqu’au retour de l’armée."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Send your hero with a raid to earn XP on return. Support adds 2 attack points per level, up to 20 points. The hero stays unavailable until the army returns."
        }
      }
    }
  },
