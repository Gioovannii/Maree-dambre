      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One assault every 24 hours, starting 24 hours after your protection ends. After time away, at most one assault per village on return. Find the report in Messages."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un assaut toutes les 24 h, à partir de 24 h après votre protection. Après une absence, au plus un assaut par village au retour. Le rapport arrive dans Messages."
          }
        }
      }
    },
    "bots.rules_rest" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At most one automatic raid per 24 hours per village, after your protection. Missed raids do not accumulate while you are away. The garrison defends automatically; reports await in Messages."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au plus un raid automatique par 24 h et par village, après votre protection. Aucune accumulation pendant votre absence. La garnison défend automatiquement ; les rapports attendent dans Messages."
          }
        }
      }
    },
