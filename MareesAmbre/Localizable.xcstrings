    "screen.defense.clock_rules" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tide advances only when you choose. Production, construction and recruitment keep their current timers. No assault resolves while you are away."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une marée avance uniquement avec votre accord. Production, construction et recrutement gardent leurs délais actuels. Aucun assaut ne se résout pendant votre absence."
          }
        }
      }
    },
    "screen.defense.clock_rules_scheduled" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular assaults advance the tides through combat and any convoy returns due. You can also advance a tide manually. A battle postpones the next regular assault by 24 hours."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les assauts réguliers font avancer les marées jusqu’au combat et au retour des convois concernés. Vous pouvez aussi avancer une marée manuellement. Un combat repousse le prochain assaut régulier de 24 h."
          }
        }
      }
    },
