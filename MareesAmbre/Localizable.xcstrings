        }
      }
    }
  },
  "backup.import": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Importer une partie"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Import a game"
        }
      }
    }
  },
  "backup.warning": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "L’import remplace la partie de cet appareil après confirmation. Une copie locale de la sauvegarde précédente sera conservée. Les parties ne sont pas fusionnées."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Import replaces progress on this device after confirmation. A local copy of the previous save is retained. Games are not merged."
        }
      }
    }
  },
  "backup.title": {
