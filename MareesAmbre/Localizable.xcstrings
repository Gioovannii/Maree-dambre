    "guide.blocker_construction": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chantier est en cours. Les champs et les bâtiments partagent ce chantier : attends sa fin ou examine son annulation avant d’en lancer un autre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Construction is underway. Fields and buildings share this slot: wait for it to finish or review cancellation before starting another project."
          }
        }
      }
    },
    "guide.blocker_general": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie le coût, la place dans l’entrepôt et les prérequis de l’action. Pour recruter, il faut rechercher l’unité puis l’entraîner à la Cour des armes. Un bouton grisé peut aussi indiquer qu’une tâche est déjà en cours."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the cost, warehouse capacity, and action requirements. To recruit, research the unit and then train it at the Training Grounds. A disabled button may also mean a task is already underway."
          }
        }
      }
    },
    "guide.you": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You"
          }
        }
      }
    },
    "guide.complete": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparons ton deuxième village. Dans Monde, ouvre Colonisation : améliore la capitale, recherche la navigation, prépare les colons puis choisis une terre. Un refuge permet de vivre sans subir d’attaques."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let’s prepare your second village. In World, open Colonization: develop the capital, research navigation, prepare settlers and choose a site. A refuge allows you to live without being attacked."
          }
        }
      }
    },
