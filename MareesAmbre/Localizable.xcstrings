            "value": "Un assaut toutes les 24 h, à partir de 24 h après votre protection. Après une absence, au plus un assaut par village au retour. Le rapport arrive dans Messages."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One assault every 24 hours, starting 24 hours after your protection ends. After time away, at most one assault per village on return. Find the report in Messages."
          }
        }
      }
    },
    "screen.defense.clock_rules_scheduled": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les assauts réguliers font avancer les marées jusqu’au combat et au retour des convois concernés. Vous pouvez aussi avancer une marée manuellement. Un combat repousse le prochain assaut régulier de 24 h."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regular assaults advance the tides through combat and any convoy returns due. You can also advance a tide manually. A battle postpones the next regular assault by 24 hours."
          }
        }
      }
    },
