  "recon.stale": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Renseignement ancien : les effectifs peuvent avoir changé. Actualisez avant de vous y fier."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Old intelligence: troop numbers may have changed. Refresh before relying on it."
        }
      }
    }
  },
  "recon.rules": {
    "extractionState": "manual",
    "localizations": {
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Observation immédiate depuis les routes, sans envoyer de soldats. Académie requise. Le renseignement reste récent pendant dix minutes."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Immediate observation from nearby routes, without sending soldiers. Requires an Academy. Intelligence stays recent for ten minutes."
        }
      }
    }
  },
